# $ Permite que la función actúe como una macro leyendo los parámetros del JSON

# 1. Comando específico para la velocidad de los zombis
$scoreboard players set #config zombie_speed $(zombie)

# 2. Comando específico para las arañas de cueva
$scoreboard players set #config cave_spider_speed $(spider)

# 3. Comando específico para el random tick speed de la Luna de Cosecha
$scoreboard players set #config harvestmoon_random_tickrate $(harvest)
